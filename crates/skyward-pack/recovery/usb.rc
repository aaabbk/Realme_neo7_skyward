# The USB function a computer reaches this recovery through: adb, on the
# controller the phone's own rules bind it to. The gadget is made here, as
# the phone maker's rules make it, because those rules are on the vendor
# partition, which a phone without a system does not have.
#
# skyward-pack writes the controller in place of @UDC@.

on fs
    setprop sys.usb.controller "@UDC@"

    # File transfer's rules come after these and take the folder to be there.
    mkdir /config 0755 root root
    mount configfs none /config
    chmod 0755 /config
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell

    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x22d9
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bcdUSB 0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber skyward
    write /config/usb_gadget/g1/strings/0x409/manufacturer Skyward
    write /config/usb_gadget/g1/strings/0x409/product "Skyward Recovery"

    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500

    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000,no_disconnect=1

    # File transfer's function, which Skyward writes the descriptors of as
    # the port goes to it.
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=0,gid=0

# The older gadget the kernel also keeps, which the phone's own recovery
# brings adb up on: a kernel whose configfs gadget does not take this port
# has this one, and the recovery falls back to it. Its rules are written
# only where it is the gadget in use: a kernel that has no such gadget
# leaves no files here to write.
on property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/f_ffs/aliases adb,fastboot,mtp
    write /sys/class/android_usb/android0/idVendor 18D1
    write /sys/class/android_usb/android0/iManufacturer Skyward
    write /sys/class/android_usb/android0/iProduct "Skyward Recovery"
    write /sys/class/android_usb/android0/iSerial skyward

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb
    write /config/usb_gadget/g1/idProduct 0x2769
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    start adbd

# adbd writes its descriptors to the function as it starts, and the phone's
# own rules bind the port to the controller only once that function is ready:
# binding it before hands the host a port with no function on it.
on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state adb

on property:sys.usb.config=none && property:sys.usb.configfs=1
    # adbd's function goes with adbd, and the property that says it is ready
    # with it: the next configuration waits for adbd to say so again.
    setprop sys.usb.ffs.ready 0
    rm /config/usb_gadget/g1/configs/b.1/f1
    stop adbd
    setprop sys.usb.state none

# The port on the gadget the kernel has always had: the phone's own recovery
# reaches a computer this way, where the configfs gadget takes no port.
on property:sys.usb.config=adb && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/idProduct D001
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state adb

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/idProduct 4EE2
    write /sys/class/android_usb/android0/functions mtp,adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state mtp,adb

on property:sys.usb.config=none && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/enable 0
    stop adbd
    setprop sys.usb.state none

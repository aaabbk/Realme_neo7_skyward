# The USB function a computer reaches this recovery through: adb, on the
# controller the phone's own rules bind it to. The gadget is made here, as
# the phone maker's rules make it, because those rules are on the vendor
# partition, which a phone without a system does not have.
#
# skyward-pack writes the controller in place of @UDC@.

on fs
    setprop sys.usb.controller "@UDC@"

    # File transfer's rules come after these and take the folder to be there.
    mkdir /config 0755 root root
    mount configfs none /config
    chmod 0755 /config
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell

    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x22d9
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bcdUSB 0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber skyward
    write /config/usb_gadget/g1/strings/0x409/manufacturer Skyward
    write /config/usb_gadget/g1/strings/0x409/product "Skyward Recovery"

    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500

    mount functionfs adb /dev/usb-ffs/adb rmode=0770,fmode=0660,uid=2000,gid=2000,no_disconnect=1

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/ffs.adb
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    start adbd
    setprop sys.usb.state adb

on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC none
    stop adbd
    setprop sys.usb.state none
